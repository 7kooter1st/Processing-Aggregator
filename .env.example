DATABASE_URL=postgresql://comparator:comparator@127.0.0.1:5432/comparator
DATABASE_POOL_MIN_SIZE=1
DATABASE_POOL_MAX_SIZE=5
INTERNAL_API_TOKEN=comparator-local-internal

KAFKA_BOOTSTRAP_SERVERS=localhost:9092,localhost:9094,localhost:9096
KAFKA_CONSUMER_GROUP=processing-service
KAFKA_REPLICATION_FACTOR=3
PIPELINE_VERSION=v2
OBJECT_STORE_BACKEND=s3
S3_ENDPOINT_URL=http://127.0.0.1:9000
S3_ACCESS_KEY=comparator
S3_SECRET_KEY=comparator-secret
S3_BUCKET=comparator
S3_REGION=us-east-1
ALLOW_MULTIPLE_REPLICAS=false
CONSUMER_MAX_CONCURRENT=1
COMPARE_MAX_CONCURRENT=1
OLLAMA_MAX_CONCURRENT=1
KAFKA_CONSUMER_GROUP_AGGREGATOR=processing-service-aggregator
KAFKA_TOPIC_RAW_CHUNKS=raw_chunks
KAFKA_TOPIC_PROCESSED_RESULTS=processed_results
KAFKA_TOPIC_STATUS_UPDATES=status_updates
KAFKA_TOPIC_DLT=raw_chunks_dlt
KAFKA_MAX_REQUEST_SIZE_BYTES=10485760

# Use 127.0.0.1 (not localhost) on Windows to avoid IPv6 connect issues
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma4:26b
OLLAMA_NUM_CTX=8192
OLLAMA_TIMEOUT_SECONDS=300
OLLAMA_TEMPERATURE=0.1
# Required false for gemma4 OCR: omitting think defaults to thinking-on and empty content
OLLAMA_THINK=false
OLLAMA_RETRIES=3
OLLAMA_RETRY_DELAY_SECONDS=3
OLLAMA_STARTUP_TIMEOUT_SECONDS=120
OCR_IMAGE_MAX_WIDTH=1280
OCR_IMAGE_JPEG_QUALITY=75

APP_PORT=5001
CONSUMER_MAX_CONCURRENT=1
